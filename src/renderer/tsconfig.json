{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "baseUrl": ".",
    "noImplicitAny": true,
    "allowJs": false,
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "node",
    "sourceMap": true,
    "preserveConstEnums": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "allowUnusedLabels": true,
    "noUnusedLocals": false,
    "strictNullChecks": false,
    "lib": [
      "dom",
      "es7",
      "esnext"
    ],
    "typeRoots": [
      "../../node_modules/@types"
    ],
    "paths": {
      "Icons": [
        "../renderer/Common/Icons"
      ],
      "Icons/*": [
        "../renderer/Common/Icons/*"
      ],
      "Common": [
        "../renderer/Common"
      ],
      "Common/*": [
        "../renderer/Common/*"
      ],
      "Const": [
        "../constants"
      ],
      "Utils": [
        "../utils"
      ],
      "Utils/*": [
        "../utils/*"
      ],
      "Types": [
        "../types"
      ],
      "Types/*": [
        "../types/*"
      ],
      "*": [
        "../../node_modules/@types/*"
      ]
    }
  },
  "include": [
    "../constants/**/*",
    "../types/**/*",
    "../utils/Common/*",
    "../utils/Render/*",
    "**/*"
  ]
}
