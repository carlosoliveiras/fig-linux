{
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "noImplicitAny": true,
    "allowJs": false,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "preserveConstEnums": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "allowUnusedLabels": true,
    "noUnusedLocals": false,
    "strictNullChecks": false,
    "lib": [
      "dom",
      "es7",
      "esnext"
    ],
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "Main": [
        "src/main"
      ],
      "Main/*": [
        "src/main/*"
      ],
      "Icons": [
        "src/renderer/Common/Icons"
      ],
      "Icons/*": [
        "src/renderer/Common/Icons/*"
      ],
      "Common": [
        "src/renderer/Common"
      ],
      "Common/*": [
        "src/renderer/Common/*"
      ],
      "Const": [
        "src/constants"
      ],
      "Utils": [
        "src/utils"
      ],
      "Utils/*": [
        "src/utils/*"
      ],
      "Storage": [
        "src/main/Storage.ts"
      ],
      "Types": [
        "src/types"
      ],
      "Types/*": [
        "src/types/*"
      ],
      "*": [
        "node_modules/@types/*"
      ]
    }
  },
  "include": [
    "src/constants/**/*",
    "src/main/**/*",
    "src/types/**/*",
    "src/utils/**/*"
  ],
  "exclude": [
    "src/types/Renderer/tabView.d.ts"
  ]
}
