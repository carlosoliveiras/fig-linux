{
  "appId": "fig-linux",
  "productName": "fig-linux",
  "icon": "resources/icons",
  "extraFiles": [
    {
      "from": "resources/AppRun",
      "to": "AppRun"
    },
    {
      "from": "resources/icons",
      "to": "icons"
    }
  ],
  "files": [
    "**/*"
  ],
  "directories": {
    "app": "dist/",
    "output": "build/installers"
  },
  "fileAssociations": [
    {
      "ext": "fig",
      "name": "Figma File",
      "role": "Editor"
    }
  ],
  "protocols": [
    {
      "name": "figma",
      "role": "Viewer",
      "schemes": [
        "figma"
      ]
    }
  ],
  "rpm": {
    "fpm": [
      "--rpm-rpmbuild-define=_build_id_links none"
    ]
  },
  "appImage": {
    "category": "Graphics",
    "desktop": "resources/fig-linux-appimage.desktop"
  },
  "linux": {
    "description": "Unofficial desktop application for linux",
    "icon": "resources/icons",
    "category": "Graphics",
    "packageCategory": "Graphics",
    "maintainer": "Jos\u00e9 Carlos <vxcarlosig@gmail.com>",
    "artifactName": "${name}_${version}_${platform}_${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "fig",
        "name": "Figma File",
        "role": "Editor"
      }
    ],
    "target": [
      {
        "target": "deb"
      },
      {
        "target": "zip"
      },
      {
        "target": "rpm"
      },
      {
        "target": "pacman"
      },
      {
        "target": "appimage"
      }
    ]
  }
}
